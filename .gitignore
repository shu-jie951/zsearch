# ---------- 依赖 ----------
node_modules/
npm-debug.log*
yarn-error.log*

# ---------- 运行时数据 ----------
# 缓存、源健康度、熔断状态等，都是跑起来自己生成的
data/
_server.log
*.log

# ---------- 质检 / 截图产物 ----------
# 这些都能由仓库里的脚本重新生成，不进版本库（否则每次跑质检都脏工作区）
_e2e_report.json
_perf_wall_*.json
_perf_grain.json
_editor_*.png
preview-fade-*.png
_shot_*.png
# Edge 无头模式用的浏览器 profile（_qa_ui.js / 截图脚本的 --user-data-dir），几十 MB
_ui_profile/
# _shot_ab.js 出的 A/B 对比图（整页 + 2 倍放大，三个视觉场景）
_ab_*.png
# 各脚本重定向出来的运行日志
_*_out.txt
_t*.json
_hhp*.json
_tmp_*.js

# 原地改之前的整目录备份快照
_bak/

# 一次性诊断产物（对比裁切图、壁纸原图备份等，验完就没有再看的价值）
_diag/

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---------- Python 缓存 ----------
__pycache__/
*.pyc
